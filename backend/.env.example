# ==============================================================================
# TemanHari Backend Configuration (.env.example)
# Salin file ini menjadi .env lalu isi nilainya.
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
MOBILE_DEEP_LINK_SCHEME=temanhari://auth-callback

# Database (SQLite lokal - ganti provider di prisma/schema.prisma untuk PostgreSQL)
DATABASE_URL="file:./dev.db"

# Keamanan (WAJIB diganti di produksi)
# Generate 32-byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-jwt-secret-minimal-32-karakter-yang-aman
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# 1. Google Gemini API (@google/genai)
# Dapatkan di: https://aistudio.google.com/apikey
# Jika kosong, backend berjalan dengan Smart Demo AI Fallback (Bahasa Indonesia).
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. Google Calendar OAuth 2.0 (Google Cloud Console)
# Redirect URI: ${APP_BASE_URL}/api/calendar/google/callback
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback

# ==============================================================================
# 3. Microsoft Outlook / Graph OAuth 2.0 (Microsoft Entra ID / Azure Portal)
# Redirect URI: ${APP_BASE_URL}/api/calendar/microsoft/callback
# ==============================================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/calendar/microsoft/callback

# ==============================================================================
# 4. Firebase Cloud Messaging (FCM) - Firebase Admin SDK
# Pilihan A: path ke file JSON service account
# Pilihan B: langsung isi 3 variabel FIREBASE_PROJECT_ID, CLIENT_EMAIL, PRIVATE_KEY
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
